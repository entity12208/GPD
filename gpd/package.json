{
  "name": "gpd-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Geo-Political Domination \u2014 web client (TypeScript + React)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:backend": "node ../tools/check-supabase.mjs",
    "setup:env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env'))fs.copyFileSync('.env.example','.env')\"",
    "predev": "npm run setup:env && npm run setup:desktop",
    "prebuild": "npm run setup:env && npm run setup:desktop",
    "setup:desktop": "node ../tools/build-desktop-zip.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
